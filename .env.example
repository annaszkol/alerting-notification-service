# Copy to deploy/.env (next to docker-compose.yml) to override the defaults. Never commit .env.
# All values below are local-only demo defaults, not real secrets.

POSTGRES_USER=alerting
POSTGRES_PASSWORD=alerting
POSTGRES_DB=alerting
POSTGRES_PORT=5432

# Partitions of the events.raw topic; processor instances scale up to this number (spec §10).
EVENTS_RAW_PARTITIONS=12

LOG_LEVEL=INFO

# Base URL of the web UI, used for links in emails and SMS (/a/<id>).
PUBLIC_BASE_URL=http://localhost:5173
