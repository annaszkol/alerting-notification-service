 "GET /runbooks": [
  {
   "id": "high-error-rate-payments",
   "owner": {
    "team": "payments"
   },
   "title": "High error rate in payments-api",
   "format": "markdown",
   "original": "1. Open the payments-api dashboard and check which endpoint fails.\n2. Check recent deploys of payments-api; roll back if one started the errors.\n3. Check the database connection pool (saturation, timeouts).\n4. Post a status update in #payments-incidents.\n",
   "canonical": {
    "id": "high-error-rate-payments",
    "mode": "manual",
    "owner": {
     "team": "payments"
    },
    "steps": [
     {
      "id": "step-1",
      "kind": "text",
      "text": "Open the payments-api dashboard and check which endpoint fails."
     },
     {
      "id": "step-2",
      "kind": "text",
      "text": "Check recent deploys of payments-api; roll back if one started the errors."
     },
     {
      "id": "step-3",
      "kind": "text",
      "text": "Check the database connection pool (saturation, timeouts)."
     },
     {
      "id": "step-4",
      "kind": "text",
      "text": "Post a status update in #payments-incidents."
     },
     {
      "id": "step-9",
      "kind": "action",
      "action": "notify",
      "params": {
       "to": {
        "oncall": "payments"
       },
       "message": "check {{$service}}",
       "channels": [
        "sms"
       ]
      },
      "approval": "required",
      "attempts": 2,
      "approval_role": "member"
     }
    ],
    "title": "High error rate in payments-api",
    "format": "markdown"
   },
   "mode": "manual",
   "approvedBy": "erin",
   "approvedAt": "2026-11-21T06:10:06.711983+00:00",
   "updatedBy": "erin",
   "updatedAt": "2026-11-21T06:10:06.700325+00:00"
  },
  {
   "id": "pricing-latency",
   "owner": {
    "team": "pricing"
   },
   "title": "Pricing engine latency",
   "format": "checklist",
   "original": "- [ ] Check quote latency of {{$service}} on the pricing dashboard\n- [ ] Compare with the other pricing-engine instances\n- [ ] If only one instance is slow, drain it from the load balancer\n- [ ] Tell the pricing on-call person what you did\n",
   "canonical": {
    "id": "pricing-latency",
    "mode": "manual",
    "owner": {
     "team": "pricing"
    },
    "steps": [
     {
      "id": "item-1",
      "kind": "text",
      "text": "Check quote latency of {{$service}} on the pricing dashboard",
      "checkbox": true
     },
     {
      "id": "item-2",
      "kind": "text",
      "text": "Compare with the other pricing-engine instances",
      "checkbox": true
     },
     {
      "id": "item-3",
      "kind": "text",
      "text": "If only one instance is slow, drain it from the load balancer",
      "checkbox": true
     },
     {
      "id": "item-4",
      "kind": "text",
      "text": "Tell the pricing on-call person what you did",
      "checkbox": true
     }
    ],
    "format": "checklist"
   },
   "mode": "manual",
   "approvedBy": "grace",
   "approvedAt": "2026-11-21T06:08:56.179952+00:00",
   "updatedBy": "seed",
   "updatedAt": "2026-11-21T06:08:56.179952+00:00"
  },
  {
   "id": "settlement-timeout",
   "owner": {
    "team": "settlements"
   },
   "title": "Settlement timeout",
   "format": "yaml",
   "original": "runbook: settlement-timeout\nmatch: { all: [ { type: WORKFLOW_FAILED }, { error.code: TIMEOUT } ] }\nsteps:\n  - check: \"Is counterparty-service healthy?\"\n    action: http_get\n    url: http://counterparty-service/health\n  - action: retry_workflow\n    params: { workflowId: \"{{workflowId}}\" }\n    if: fails twice\n    then: escalate\n  - action: escalate\n    team: counterparty-support\n    approval: required\n",
   "canonical": {
    "id": "settlement-timeout",
    "mode": "auto",
    "match": {
     "all": [
      {
       "type": "WORKFLOW_FAILED"
      },
      {
       "error.code": "TIMEOUT"
      }
     ]
    },
    "owner": {
     "team": "settlements"
    },
    "steps": [
     {
      "id": "check-counterparty",
      "kind": "action",
      "title": "Is counterparty-service healthy?",
      "action": "http_get",
      "params": {
       "url": "http://counterparty-service/health"
      },
      "approval": "none"
     },
     {
      "id": "retry",
      "kind": "action",
      "title": "Retry workflow {{workflowId}}",
      "action": "retry_workflow",
      "params": {
       "workflowId": "{{workflowId}}"
      },
      "approval": "none",
      "attempts": 2,
      "resolves": true,
      "on_failure": "escalate"
     },
     {
      "id": "escalate",
      "kind": "action",
      "title": "Escalate to counterparty-support",
      "action": "escalate",
      "params": {
       "team": "counterparty-support"
      },
      "approval": "required"
     }
    ],
    "format": "yaml"
   },
   "mode": "auto",
   "approvedBy": "carol",
   "approvedAt": "2026-11-21T06:08:56.179952+00:00",
   "updatedBy": "seed",
   "updatedAt": "2026-11-21T06:08:56.179952+00:00"
  }
 ],
