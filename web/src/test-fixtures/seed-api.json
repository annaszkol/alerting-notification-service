     "map": {
      "INFO": "info",
      "WARN": "warning",
      "ERROR": "error",
      "CRITICAL": "critical"
     },
     "from": "severity"
    },
    "$eventTime": {
     "from": "timestamp",
     "format": "iso8601"
    },
    "$environment": "environment",
    "$correlationKey": "{{workflowId}}"
   },
