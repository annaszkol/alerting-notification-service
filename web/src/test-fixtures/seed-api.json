 "GET /rules": [
  {
   "id": "anna-payments-critical",
   "owner": {
    "user": "anna"
   },
   "enabled": true,
   "when": {
    "all": [
     {
      "$service": "payments-api"
     },
     {
      "$severity": "critical"
     }
    ]
   },
   "route": [
    {
     "to": {
      "user": "anna"
     },
     "channels": {
      "schedule": [
       {
        "use": [
         "sms"
        ],
        "between": "08:00-20:00"
       }
      ],
      "otherwise": [
       "email"
      ]
     }
    }
   ],
   "present": {},
   "dedup": {},
   "autoResolveAfter": null,
   "runbooks": [
    "high-error-rate-payments"
   ],
   "updatedBy": "seed",
   "updatedAt": "2026-11-21T06:08:56.179952+00:00"
  },
  {
   "id": "pricing-warnings",
   "owner": {
    "team": "pricing"
   },
   "enabled": true,
   "when": {
    "all": [
     {
      "$service": {
       "glob": "pricing-engine-*"
      }
     },
     {
      "$severity": {
       "gte": "warning"
      }
     }
    ]
   },
   "route": [],
   "present": {
    "title": "{{instrument}}: {{$count}} ostrze\u017ce\u0144 z pricing-engine",
    "fields": [
     "$service",
     "msg"
    ]
   },
   "dedup": {
    "key": [
     "instrument"
    ],
    "mode": "window",
    "window": "5m"
   },
   "autoResolveAfter": "30m",
   "runbooks": [
    "pricing-latency"
   ],
   "updatedBy": "seed",
   "updatedAt": "2026-11-21T06:08:56.179952+00:00"
  },
  {
   "id": "rates-large-rejections",
   "owner": {
    "team": "rates"
   },
   "enabled": true,
   "when": {
    "all": [
     {
      "$schema": {
       "glob": "trade.rejected.*"
      }
     },
     {
      "payload.desk": "rates"
     },
     {
      "payload.notional": {
       "gt": 10000000
      }
     }
    ]
   },
   "route": [
    {
     "to": {
      "team": "rates"
     },
     "channels": [
      "email"
     ]
    }
   ],
   "present": {
    "title": "Rejected {{payload.currency}} {{payload.notional}} \u2014 {{payload.reason}}"
   },
   "dedup": {
    "key": [
     "payload.tradeId"
    ],
    "mode": "until_resolved"
   },
   "autoResolveAfter": null,
   "runbooks": [],
   "updatedBy": "seed",
   "updatedAt": "2026-11-21T06:08:56.179952+00:00"
  },
  {
   "id": "settlements-prod-failures",
   "owner": {
    "team": "settlements"
   },
   "enabled": true,
   "when": {
    "all": [
     {
      "type": "WORKFLOW_FAILED"
     },
     {
      "workflowName": "order-settlement"
     },
     {
      "$environment": "prod"
     }
    ]
   },
   "route": [
    {
     "to": {
      "oncall": "settlements"
     },
     "channels": [
      "phone",
      "sms"
     ]
    }
   ],
   "present": {
    "body": "Step {{step}}: {{error.message}}",
    "color": "red",
    "title": "Settlement failed: {{workflowId}}",
    "fields": [
     "step",
     "error.message"
    ]
   },
   "dedup": {
    "key": [
     "workflowId"
    ],
    "mode": "until_resolved"
   },
   "autoResolveAfter": null,
   "runbooks": [
    "settlement-timeout"
   ],
   "updatedBy": "seed",
   "updatedAt": "2026-11-21T06:08:56.179952+00:00"
  }
 ],
